<?xml version="1.0" encoding="UTF-8" ?>
<xs:schema xmlns:xs= "http://www.w3.org/2001/XMLSchema">
	<xs:complexType name= "ResourcePool">
		<xs:sequence>
			<xs:element name="Resource" type="resourceType" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="resourceType">
		<xs:sequence>
			<xs:element name="FirstName" type="valueAttributeType" maxOccurs="unbounded"/>
			<xs:element name="LastName" type="valueAttributeType" maxOccurs="unbounded"/>
			<xs:element name="Profession" type="valueAttributeType" maxOccurs="unbounded"/>
			<xs:element name="Department" type="valueAttributeType" maxOccurs="unbounded"/>
			<xs:element name="MeansOfTransport" type="valueAttributeType" maxOccurs="unbounded"/>
			<xs:element name="Skill" type="valueAttributeType" maxOccurs="unbounded"/>
			<xs:element name="Trait" type="traitType" maxOccurs="unbounded"/>
			<xs:element name="WorkAgreement" type="workAgreementType" maxOccurs="unbounded"/>
			<xs:element name="Photo" type="photoType" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="Child" type="childType" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="Stressor" type="valueAttributeType" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="PersonalInfo" type="valueAttributeType" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="Studies" type="studieType" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="Training" type="valueAttributeType" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="Qualification" type="valueAttributeType" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="AdditionalJob" type="additionalJobType" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="ProfessionalInfo" type="valueAttributeType" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
		<xs:attribute name="id" type="xs:ID" use="required"/>
		<xs:attribute name="age" type="xs:duration" use="required"/>
		<xs:attribute name="prefix" type="xs:string" />
		<xs:attribute name="maritalState" type="xs:string" use="required"/>
		<xs:attribute name="workExperience" type="xs:duration"/>
		<xs:attribute name="trainingDuration" type="xs:duration"/>
		<xs:attribute name="weeklyHours" type="xs:duration" use="required"/>
		<xs:attribute name="overtime" type="xs:duration"/>
		<xs:attribute name="yearlyTimeOf" type="xs:duration" use="required"/>
		<xs:attribute name="yearlyEducation" type="xs:duration"/>
		<xs:attribute name="commuteTime" type="xs:duration" use="required"/>
	</xs:complexType>
	<xs:complexType name="photoType">
		<xs:attribute name="path" type="xs:anyURI"/>
	</xs:complexType>
	<xs:complexType name="childType">
		<xs:attribute name="age" type="xs:duration" use="required"/>
	</xs:complexType>
	<xs:complexType name="workAgreementType">
		<xs:attribute name="value" type="workAgreementStringType" use="required"/>
	</xs:complexType>
	<xs:simpleType name="workAgreementStringType">
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-6]-(0\d|1\d|2[0-3]):[0-5]\d-(0\d|1\d|2[0-3]):[0-5]\d"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name ="studieType">
		<xs:attribute name="name" type="xs:string" use="required"/>
		<xs:attribute name="location" type="xs:string"/>
	</xs:complexType>
	<xs:complexType name="additionalJobType">
		<xs:attribute name="name" type="xs:string" use="required"/>
		<xs:attribute name="yearlyRequiredDays" type="xs:duration"/>
	</xs:complexType>
	<xs:complexType name ="valueAttributeType">
		<xs:attribute name="value" type="xs:string" use="required"/>
	</xs:complexType>
	<xs:complexType name ="traitType">
		<xs:attribute name="name" type="xs:string" use="required"/>
		<xs:attribute name="value" type="percentageType" use="required"/>
	</xs:complexType>
	<xs:simpleType name ="percentageType">
		<xs:restriction base="xs:integer">
			<xs:minInclusive value="0"/>
			<xs:maxInclusive value="100"/>
		</xs:restriction>
	</xs:simpleType>
</xs:schema>